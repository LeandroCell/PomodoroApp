{
  "expo": {
    "name": "Pomodoro Brew",
    "slug": "pomodoro-brew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pomodorobrew",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5EFE6",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pomodorobrew.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.pomodorobrew.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Pomodoro Brew",
      "shortName": "PomodoroBrew",
      "themeColor": "#8B5E3C",
      "backgroundColor": "#F5EFE6",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8B5E3C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#8B5E3C"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
